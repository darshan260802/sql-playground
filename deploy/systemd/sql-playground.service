# SQL Playground: Go API + website. Installed by deploy/install.sh as
# /etc/systemd/system/sql-playground.service. Settings: /etc/sql-playground/config.env
[Unit]
Description=SQL Playground
Documentation=https://github.com/darshan260802/sql-playground
# Starts after MySQL, and restarts with it.
Requires=mysql.service
After=network.target mysql.service

[Service]
Type=simple
User=sqlpg
Group=sqlpg
EnvironmentFile=/etc/sql-playground/config.env
ExecStart=/usr/local/lib/sql-playground/bin/sqlpg serve
Restart=always
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65536

# The app only talks to MySQL and serves HTTP: it never writes files.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
