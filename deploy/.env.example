# Copy to .env and edit. Never commit .env.

# MySQL root password (the app uses it to create per-user accounts and schemas).
MYSQL_ROOT_PASSWORD=change-me-to-a-long-random-string

# Port on 127.0.0.1 that nginx proxies to. Pick a free one if 8080 is taken.
APP_PORT=8080

# Keep true behind HTTPS (cookies are only sent over TLS). Set false only for plain-HTTP testing.
COOKIE_SECURE=true

# Accounts and limits
MAX_USERS=20
USER_QUOTA_MB=300
QUERY_TIMEOUT=30s
ANON_QUERY_TIMEOUT=15s
MAX_ROWS=2000
MAX_CONCURRENT=8

# Hard memory cap for the MySQL container
MYSQL_MEM_LIMIT=3g
