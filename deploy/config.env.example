# SQL Playground settings, read by the systemd service and by sqlpg-admin.
# deploy/install.sh copies this to /etc/sql-playground/config.env on the first install
# and fills in the MySQL password. Later installs keep your edited copy.
#
# After a change:  sudo systemctl restart sql-playground
# Write plain KEY=value lines: no spaces around "=", no quotes.

# Address nginx proxies to. Keep 127.0.0.1 so the app is only reachable through nginx.
SQLPG_LISTEN=127.0.0.1:8080

# MySQL account the app uses to create learner accounts and databases (created by install.sh).
SQLPG_MYSQL_ADDR=127.0.0.1:3306
SQLPG_MYSQL_ADMIN_USER=sqlpg_admin
SQLPG_MYSQL_ADMIN_PASSWORD=

# The built website.
SQLPG_STATIC_DIR=/usr/local/lib/sql-playground/web

# The site is served over HTTPS through nginx. Set SQLPG_COOKIE_SECURE=false only to
# test over plain http://, or the browser won't send the login cookie.
SQLPG_COOKIE_SECURE=true
SQLPG_TRUST_PROXY=true

# Accounts and limits
SQLPG_MAX_USERS=20
SQLPG_USER_QUOTA_MB=300
SQLPG_QUERY_TIMEOUT=30s
SQLPG_ANON_QUERY_TIMEOUT=15s
SQLPG_MAX_ROWS=2000
SQLPG_MAX_CONCURRENT=8
